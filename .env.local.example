# Copy to .env.local (gitignored) and fill in real values.
# .env.local is for your eyes only — never commit it, never put its contents in a PR.

# Local test server (docker container navidrome-test, see CLAUDE.md "Test servers")
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=test
NAVIDROME_PASSWORD=contents-of-~/amperfy-test-navidrome/password

# Personal server, real data: read-only curl probes only
REAL_NAVIDROME_URL=http://your-server:4533
REAL_NAVIDROME_USER=your-username
REAL_NAVIDROME_PASSWORD=your-password
